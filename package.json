{
  "name": "@makerx/yoke",
  "version": "0.1.0",
  "description": "Lean, user-invoked Claude Code skills for MakerX AI-assisted delivery, plus the CLI they call.",
  "license": "MIT",
  "author": "MakerX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MakerXStudio/yoke.git"
  },
  "bin": {
    "yoke": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results.xml",
    "verify": "verifyx",
    "verify:lint": "verifyx lint",
    "verify:format": "verifyx format",
    "verify:check-types": "verifyx check-types",
    "verify:unused-code": "verifyx unused-code",
    "verify:complexity": "verifyx complexity \"src/**/*.ts\"",
    "verify:comments": "verifyx comments",
    "verify:github-actions": "verifyx github-actions",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@makerx/verify": "^1.3.0",
    "@types/node": "^24.0.0",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
